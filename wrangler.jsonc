{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ali-medixo",
  "compatibility_date": "2026-09-15",
  "pages_build_output_dir": "build/web",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/web",
    "not_found_handling": "single-page-application"
  }
}
